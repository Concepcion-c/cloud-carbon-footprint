\pard\pardeftab720\sa350\partightenfactor0
\cf4 \cb9 Langfuse's OpenAI SDK is a drop-in replacement for the OpenAI client that automatically records your model calls without changing how you write code. If you already use the OpenAI python SDK, you can start using Langfuse with minimal changes to your code.\cb1 \
\cb9 Start by installing the Langfuse OpenAI SDK. It includes the wrapped OpenAI client and sends traces in the background.\cb1 \
\pard\pardeftab720\qc\partightenfactor0

\f2 \cf10 \strokec10 \
\pard\pardeftab720\partightenfactor0

\f4\fs19\fsmilli9750 \cf13 \cb12 \strokec13 pip\cf14 \strokec14  install langfuse\cf11 \cb1 \strokec11 \
\pard\pardeftab720\sa350\partightenfactor0

\f1\fs28 \cf4 \cb9 \strokec4 Set your Langfuse credentials as environment variables so the SDK knows which project to write to.\cb1 \
\pard\pardeftab720\qc\partightenfactor0

\f2 \cf10 \strokec10 \
\pard\pardeftab720\partightenfactor0

\f4\fs19\fsmilli9750 \cf13 \cb12 \strokec13 LANGFUSE_SECRET_KEY\cf14 \strokec14  = "sk-lf-..."\cf11 \cb1 \strokec11 \
\cf13 \cb12 \strokec13 LANGFUSE_PUBLIC_KEY\cf14 \strokec14  = "pk-lf-..."\cf11 \cb1 \strokec11 \
\cf13 \cb12 \strokec13 LANGFUSE_BASE_URL\cf14 \strokec14  = "https://cloud.langfuse.com"\cf15 \strokec15  # \uc0\u55356 \u56810 \u55356 \u56826  EU region\cf11 \cb1 \strokec11 \
\pard\pardeftab720\partightenfactor0
\cf15 \cb12 \strokec15 # Other Langfuse data regions include \uc0\u55356 \u56826 \u55356 \u56824  US: https://us.cloud.langfuse.com, \u55356 \u56815 \u55356 \u56821  Japan: https://jp.cloud.langfuse.com and \u9877 \u65039  HIPAA: https://hipaa.cloud.langfuse.com\cf11 \cb1 \strokec11 \
\pard\pardeftab720\sa350\partightenfactor0

\f1\fs28 \cf4 \cb9 \strokec4 Swap the regular OpenAI import to Langfuse\'92s OpenAI drop-in. It behaves like the regular OpenAI client while also recording each call for you.\cb1 \
\pard\pardeftab720\qc\partightenfactor0

\f2 \cf10 \strokec10 \
\pard\pardeftab720\partightenfactor0

\f4\fs19\fsmilli9750 \cf16 \cb12 \strokec16 from\cf11 \strokec11  langfuse.openai \cf16 \strokec16 import\cf11 \strokec11  openai\cb1 \
\pard\pardeftab720\sa350\partightenfactor0

\f1\fs28 \cf4 \cb9 \strokec4 Use the OpenAI SDK as you normally would. The wrapper captures the prompt, model and output and forwards everything to Langfuse.\cb1 \
